{
  "name": "nbody-studio",
  "private": true,
  "version": "2.8.0",
  "description": "N-Body Studio - 2D/3D N-body gravity simulator (TypeScript + WebGL2 + Web Worker)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx tools/bench.ts",
    "bench3": "tsx tools/bench3.ts",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --dir",
    "collab": "node server/collab.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/cli": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.nbodystudio.app",
    "productName": "N-Body Studio",
    "directories": {
      "output": "release-installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "NBodyStudio-${version}-${arch}.${ext}",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "N-Body Studio",
      "artifactName": "NBodyStudio-${version}-setup.exe"
    },
    "portable": {
      "artifactName": "NBodyStudio-${version}-portable.exe"
    }
  },
  "main": "electron/main.cjs",
  "author": {
    "name": "joe",
    "email": "72416@qq.com"
  }
}
